# ElevenLabs. The agent is only a voice shell; the persona lives in lib/languages.ts.
# The API key needs ElevenAgents Read (call transcripts) and Text to Speech (listening stories).
# On the agent's Security tab, enable overrides for System prompt, First message, Language and
# Voice to give Giulia her full persona and voice. Without them calls still work: the persona is
# sent as context once the call connects, with the agent's own first line and voice.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=

# Claude writes the post-call report, flashcards, listening stories and in-call help.
ANTHROPIC_API_KEY=

# Supabase. Run supabase/schema.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daily reminder. Generate the pair once:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Any long random string. Vercel sends it as a Bearer token on the cron call.
CRON_SECRET=
